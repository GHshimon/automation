{
  "id": "daily-report",
  "name": "毎朝6時 業界ニュースレポート",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Tokyo",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "毎朝6時",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-160, 300]
    },
    {
      "parameters": {
        "command": "bash /Users/shimon/project/automation/scripts/daily_report/run.sh"
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "レポート生成+Driveアップロード",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [80, 300],
      "onError": "continueRegularOutput",
      "notes": "既存の実績パイプライン(Grok収集→Ollama/grok要約→Perplexity週次→rcloneアップロード)をそのまま実行する。config.yaml の notify は false 推奨(通知は下流のn8nノードが担当)。"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c3333333-3333-4333-8333-333333333333",
              "leftValue": "={{ $json.exitCode }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "d4444444-4444-4444-8444-444444444444",
      "name": "成功したか?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [320, 300]
    },
    {
      "parameters": {
        "command": "=terminal-notifier -title '業界ニュースレポート' -message \"$(date +%F) のレポートが完成しました ✅\""
      },
      "id": "e5555555-5555-4555-8555-555555555555",
      "name": "完了通知",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [580, 180],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "command": "terminal-notifier -title '業界ニュースレポート ❌' -message '生成に失敗しました。n8n の実行履歴でログを確認してください'"
      },
      "id": "f6666666-6666-4666-8666-666666666666",
      "name": "失敗通知",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [580, 420],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "毎朝6時": {
      "main": [
        [
          {
            "node": "レポート生成+Driveアップロード",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "レポート生成+Driveアップロード": {
      "main": [
        [
          {
            "node": "成功したか?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "成功したか?": {
      "main": [
        [
          {
            "node": "完了通知",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "失敗通知",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
